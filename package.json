{
  "name": "reimaginedlc",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "test": "node --test \"tools/**/*.test.mjs\" && vitest run && npm run test:loader",
    "test:loader": "vitest run --config loader/vite.loader.config.ts",
    "build:loader": "vite build -c loader/vite.loader.config.ts",
    "build:cdn": "vite build -c loader/vite.cdn.config.ts",
    "manifest": "node scripts/manifest.ts",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "test:src": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dev:client": "vite build --watch --mode client",
    "mock": "node tools/mock-lcu/server.mjs --idle",
    "dev:mock": "vite",
    "lcu:types": "node -e \"require('fs').copyFileSync('docs/dump/lcu/lcu-types.d.ts','src/lcu/types.d.ts')\"",
    "dump:ping": "node tools/dump/ping.mjs",
    "dump:api": "node tools/dump/fetch-api.mjs",
    "dump:assets": "node tools/dump/fetch-assets.mjs",
    "dump:collector": "node tools/dump/collector.mjs",
    "dump:plugin:install": "node tools/dump/install-plugin.mjs",
    "dump:plugin:remove": "node tools/dump/install-plugin.mjs --remove",
    "dump:record": "node tools/dump/record.mjs",
    "dump:anonymize": "node tools/dump/anonymize-session.mjs",
    "dump:screens": "node tools/dump/screens.mjs",
    "dump:baseline": "pwsh -NoProfile -File tools/dump/baseline.ps1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0"
  }
}
